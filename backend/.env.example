# ===== backend/.env.example =====
# Run this service with:  python main.py   (reads THIS file)

# --- Storage — the SHARED SQLite DB + files. Use an ABSOLUTE path so it's independent of where
#     you launch the service, and set the SAME value in ai_service/.env. (Docker: /app/storage) ---
STORAGE_DIR=storage

# --- Multi-tenancy (subdomain routing / CORS) — keep identical ---
ROOT_DOMAIN=localhost
BASE_DOMAIN_SCHEME=http
DEFAULT_TENANT_SLUG=default

# --- Networking (CORS origins + candidate links) — keep identical ---
FRONTEND_URL=http://localhost
FRONTEND_PORT=5173
BACKEND_URL=http://localhost
BACKEND_PORT=8000
AI_SERVICE_URL=http://localhost
AI_SERVICE_PORT=8100

# --- Auth (recruiter + admin JWTs, seeded account) ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
DEFAULT_ADMIN_EMAIL=admin@company.local
DEFAULT_ADMIN_PASSWORD=

# --- Super-admin panel ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Usage pricing (₹) — read by the admin usage dashboard ---
PRICE_INR_LLM_PER_MTOK_INPUT=258.0
PRICE_INR_LLM_PER_MTOK_OUTPUT=1290.0
PRICE_INR_STT_PER_MINUTE=1.3244
PRICE_INR_TTS_PER_1K_CHARS=8.60
PRICE_INR_OCR_PER_1K_PAGES=129.0

# --- Recruiter portal ---
CANDIDATES_PAGE_SIZE=5
RECRUITMENTS_PAGE_SIZE=12
ANALYTICS_CACHE_SECONDS=
ANALYTICS_CHARTS_CACHE_SECONDS=3600

# --- SMTP (candidate emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=prithwin@techgentsia.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@recruitment.local
SMTP_FROM_NAME=AI Recruitment
SMTP_USE_TLS=true

# --- Google Calendar ---
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=950602324720-htudps2kvng3uitid2ad4c2o16agabft.apps.googleusercontent.com

# --- Scheduling / interview lifecycle ---
INTERVIEW_DURATION_MINUTES=30
INTERVIEW_LINK_VALIDITY_DAYS=3
RECONNECT_GRACE_SECONDS=120
IDLE_WS_TIMEOUT_SECONDS=45
