# Reverse proxy + static app for the recruitment platform (single host).
# Set your domain + email via env in docker-compose (DOMAIN, ACME_EMAIL). Caddy obtains and
# renews the TLS cert automatically over HTTP-01 — no DNS plugin needed.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	tls {$ACME_EMAIL}

	# Cross-origin isolation — REQUIRED so the in-browser Pocket TTS WASM runs multi-threaded
	# (matches vite.config.ts). Without these the agent's voice breaks up.
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "credentialless"
	}

	# Recruiter/admin API — served NATIVELY at /api/* by the backend, so no strip_prefix: Caddy
	# forwards the request URI unchanged.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# AI service, incl. the interview WebSocket — served natively at /ai/* (Caddy upgrades WS
	# automatically). No strip_prefix here either.
	handle /ai/* {
		reverse_proxy ai_service:8100
	}

	# Single-page app: serve static build, fall back to index.html for client routing.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
