# Reverse proxy + static app for the multi-tenant recruitment platform.
# Set your domain + email here (or via env in docker-compose). Serves every tenant subdomain.
#
# TLS for wildcard subdomains: the simplest is on-demand TLS (below) which issues a cert per
# subdomain on first request over HTTP-01 — works with the stock caddy image, no DNS plugin.
# For a true *.domain wildcard cert you must build Caddy with your DNS provider's plugin (xcaddy)
# and use the `tls { dns <provider> ... }` block instead. See docs/DEPLOY.md.

{
	email {$ACME_EMAIL}
	# on-demand issuance for tenant subdomains, gated by an `ask` endpoint so this isn't an open
	# cert-issuance relay. NOTE: this currently points at a backend endpoint (GET /api/tenant/allowed
	# returning 200/403 per hostname) that is NOT present in this codebase right now — add it back
	# (see git history: backend/app/tenancy/routes.py) before relying on on-demand TLS, or switch to
	# a single wildcard cert via your DNS provider's plugin instead (see docs/DEPLOY.md).
	on_demand_tls {
		ask http://backend:8000/api/tenant/allowed
	}
}

*.{$ROOT_DOMAIN}, {$ROOT_DOMAIN} {
	tls {$ACME_EMAIL} {
		on_demand
	}

	# Cross-origin isolation — REQUIRED so the in-browser Pocket TTS WASM runs multi-threaded
	# (matches vite.config.ts). Without these the agent's voice breaks up.
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "credentialless"
	}

	# Recruiter/admin API — served NATIVELY at /api/* by the backend, so no strip_prefix: Caddy
	# forwards the request URI unchanged. Caddy forwards Host upstream by default, so tenant
	# resolution (subdomain) works.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# AI service, incl. the interview WebSocket — served natively at /ai/* (Caddy upgrades WS
	# automatically). No strip_prefix here either.
	handle /ai/* {
		reverse_proxy ai_service:8100
	}

	# Single-page app: serve static build, fall back to index.html for client routing.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
