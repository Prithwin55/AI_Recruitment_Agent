# Copy this file to .env in the repo root and fill in real values.
# Both backend/ and ai_service/ read this single root .env (see shared/shared/config.py).

# --- Claude (Anthropic) — required for Phase 1 scoring and the live interview conversation ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- SherpaOnnx — English STT (external streaming ASR WebSocket server) ---
SHERPA_STT_HOST=transcription-dev.vconsol.com
SHERPA_STT_PATH=/en
SHERPA_STT_PORT=443
SHERPA_STT_USE_WSS=true
SHERPA_STT_SECRET_KEY=

# --- Azure AI Speech — Arabic-Omani (ar-OM) STT/TTS for the live interview ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- SMTP — candidate interview-link emails (any provider: Gmail app password, SendGrid relay, Office365, ...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@recruitment.local
SMTP_FROM_NAME=AI Recruitment
SMTP_USE_TLS=true

# --- Google Calendar — service account JSON, shared with the target calendar (see docs/SETUP.md) ---
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
DEFAULT_ADMIN_EMAIL=admin@company.local
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# --- Multi-tenancy ---
# Tenants are subdomains of ROOT_DOMAIN (acme.<root_domain>). Dev: localhost -> acme.localhost:5173.
# In production set the real apex domain and BASE_DOMAIN_SCHEME=https (served behind the proxy).
ROOT_DOMAIN=localhost
BASE_DOMAIN_SCHEME=http
DEFAULT_TENANT_SLUG=default

# --- Admin panel (usage & cost dashboard at /admin) ---
# Login stays disabled until ADMIN_PASSWORD is non-empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Usage pricing in rupees (derived from USD reference rates at Rs86/$) ---
# LLM: $3 / $15 per million input/output tokens
PRICE_INR_LLM_PER_MTOK_INPUT=258.0
PRICE_INR_LLM_PER_MTOK_OUTPUT=1290.0
# STT: $0.0154 per minute of audio
PRICE_INR_STT_PER_MINUTE=1.3244
# TTS: $0.10 per 1,000 characters
PRICE_INR_TTS_PER_1K_CHARS=8.60
# OCR (resume parsing of scanned PDFs/images): $1.50 per 1,000 pages
PRICE_INR_OCR_PER_1K_PAGES=129.0

# --- Recruiter portal ---
# Number of not-shortlisted candidates listed per page on the recruitment detail view.
CANDIDATES_PAGE_SIZE=20
# Number of recruitments listed per page (recruitments list + dashboard).
RECRUITMENTS_PAGE_SIZE=12
# Coalescing window (seconds) for the dashboard's global stat tiles. Within it, repeated polls are
# served from cache; past it a cheap change-check runs and the full scan happens ONLY if candidate
# data changed. An idle dashboard never re-scans on a timer. 0 = no window (still change-gated).
ANALYTICS_CACHE_SECONDS=15
# How long (seconds) the page-scoped chart analytics (funnel bar + pipeline pie) are cached. Charts
# are computed for the current page's recruitments and reused this long; the next open after it
# expires recomputes them. Default 1 hour.
ANALYTICS_CHARTS_CACHE_SECONDS=3600

# --- Interview behavior ---
INTERVIEW_DURATION_MINUTES=25
INTERVIEW_LINK_VALIDITY_DAYS=3
RECONNECT_GRACE_SECONDS=120
IDLE_WS_TIMEOUT_SECONDS=45
PHASE1_SHORTLIST_THRESHOLD=70
PHASE1_MAX_CONCURRENCY=4
# How long the candidate can pause before the agent takes its turn (ms). Higher = more patient
# with mid-thought pauses; lower = snappier back-and-forth. Applies to English and Arabic.
INTERVIEW_END_OF_TURN_SILENCE_MS=2000

# --- Networking ---
# Each service: base URL (scheme + host only) and port, kept separate.
FRONTEND_URL=http://localhost
FRONTEND_PORT=5173
BACKEND_URL=http://localhost
BACKEND_PORT=8000
AI_SERVICE_URL=http://localhost
AI_SERVICE_PORT=8100

# --- Storage (local filesystem — no S3/MinIO for now) ---
STORAGE_DIR=./storage
