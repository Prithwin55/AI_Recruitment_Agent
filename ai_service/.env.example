# ===== ai_service/.env.example =====
# Run this service with:  python main.py   (reads THIS file)

# --- Storage — the SHARED SQLite DB + files. Use an ABSOLUTE path so it's independent of where
#     you launch the service, and set the SAME value in backend/.env. (Docker: /app/storage) ---
STORAGE_DIR=storage

# --- Networking — only the frontend origin (used for CORS) matters here; defaults suit local dev ---
FRONTEND_URL=http://localhost
FRONTEND_PORT=5173
AI_SERVICE_PORT=8100

# --- Claude (Anthropic) — resume scoring + interview + sentiment ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- SherpaOnnx — English STT ---
SHERPA_STT_HOST=transcription-dev.vconsol.com
SHERPA_STT_PATH=/en
SHERPA_STT_PORT=443
SHERPA_STT_USE_WSS=true
SHERPA_STT_SECRET_KEY=

# --- TTS — where to reach the standalone English TTS microservice, and which voice to request. The
#     service (engine, tuning) is configured via tts_service/.env. Docker: http://tts_service:8200.
#     Voice must match the service's engine — Pocket (default): alba/azelma/cosette/eponine/fantine/
#     javert/jean/marius; Kitten: expr-voice-{2..5}-{f,m}. ---
TTS_SERVICE_URL=http://localhost:8200
TTS_VOICE=cosette

# --- Azure Speech — Arabic-Omani STT/TTS ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Server-side VAD ---
VAD_AGGRESSIVENESS=
VAD_ONSET_MS=

# --- Interview engine tuning ---
INTERVIEW_END_OF_TURN_SILENCE_MS=2000
PHASE1_SHORTLIST_THRESHOLD=70
PHASE1_MAX_CONCURRENCY=4
