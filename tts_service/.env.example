# ===== tts_service/.env.example =====
# Copy to tts_service/.env and adjust. Run this service with:  python main.py   (reads THIS file).
# Standalone & stateless — it holds NO shared DB/Anthropic/Azure config; only its own knobs below.
# Real container env (docker-compose `environment:`) always wins over values in this file.

# --- Server ---
TTS_SERVICE_PORT=8200
RELOAD=1                      # local-dev autoreload; docker-compose forces RELOAD=0

# --- Engine ---
# pocket = kyutai flow-matching (natural voice, ~real-time on CPU, heavier) — the default.
# kitten = tiny nano model (fast, lighter, grainier).
TTS_ENGINE=pocket

# --- Voice ---
# ai_service also sends TTS_VOICE per request; keep them in sync. Fallback if a request omits it.
#   pocket voices: alba, azelma, cosette, eponine, fantine, javert, jean, marius
#   kitten voices: expr-voice-{2,3,4,5}-{f,m}
TTS_VOICE=cosette

# --- Pocket engine tuning ---
# Flow-matching steps: 4 = smoothest prosody (default), lower (2/1) = a bit faster but flatter.
POCKET_LSD_STEPS=4
# onnxruntime intra-op threads PER synthesis. 0 = use all cores (fastest per synthesis, best for the
# near-real-time Pocket model). Set a small number to leave cores for more concurrent syntheses.
TTS_ORT_THREADS=0

# --- Kitten engine tuning (only when TTS_ENGINE=kitten) ---
TTS_SPEED=1.3                 # tempo (higher=faster, pitch preserved); model default 1.0 is draggy

# --- Concurrency & scaling ---
# Bound per-container load so many interviews share one box and a burst sheds (503) instead of
# thrashing. Pocket is near real-time, so keep concurrency modest and scale out with replicas
# (`docker compose up -d --scale tts_service=N`).
TTS_MAX_CONCURRENCY=3         # in-flight syntheses per container before requests queue / 503
TTS_ACQUIRE_TIMEOUT_S=10      # how long a request waits for a slot before returning 503

# --- Model source (optional, Kitten only) ---
# Leave unset to download from Hugging Face (cached; baked into the image at build). Pocket always
# pulls its ONNX bundle from the KevinAHM/pocket-tts-web Space.
# TTS_MODEL_PATH=
# TTS_VOICES_PATH=
