# Frontend build-time config (Vite). Copy to .env.local to override.

# Root domain tenants are subdomains of. Must match backend ROOT_DOMAIN.
# Dev: localhost (browse acme.localhost:5173). Prod: your apex, e.g. recruit.example.com.
VITE_ROOT_DOMAIN=localhost

# Optional: absolute API base if you don't use the dev proxy (defaults to "/api").
# VITE_API_BASE_URL=/api
